import numpy as np

# ==============================================================================
# МАТЕМАТИЧНА СИМУЛЯЦІЯ СИНЕРГЕТИЧНОГО КОНТУРУ ВЗАЄМОЗВ'ЯЗАНИХ ОБ'ЄМІВ ГАЗУ
# Валідація за гармонічним рядом тисків (заявка PCT/UA2008/000015 від 20.03.2008)
# ==============================================================================

# 1. ВИХІДНІ ДАНІ ПРОЦЕСУ
P1 = 10.0  # Максимальний тиск порції газу, атм
V1 = 1.0   # Об'єм однієї вхідної порції газу, м3
N = 10     # Кількість відокремлених каскадних камер
S = 1.0    # Площа поршня, м2

# Задаємо однакове для обох систем стале навантаження (максимально ефективне для Б)
F_load = 23.99  # од. сили

# ==============================================================================
# 2. РОЗРАХУНОК СИСТЕМИ Б (Синергетичний контур кратності об'ємів)
# ==============================================================================
# Камери заповнені газом кратно (гармонічний ряд від 10 до 1 атм)
steps = 100
dV_range = np.linspace(0, V1, steps)
F_B_total = []

for dV in dV_range:
    sum_force = 0.0
    for i in range(1, N + 1):
        P_current = (P1 * V1) / (i * V1 + dV)
        sum_force += P_current * S
    F_B_total.append(sum_force)

F_B_total = np.array(F_B_total)
# Загальний хід за N кроків для повної утилізації порцій газу
h_B_total = N * (V1 / S)
Work_B = F_load * h_B_total

print("--- СИСТЕМА Б (Синергетичний контур) ---")
print(f"Початкова сумарна сила каскаду: {F_B_total[0]:.2f} од. сили (~28 атм збиткового тиску)")
print(f"Робота під сталим навантаженням {F_load}: {Work_B:.2f} Дж\n")

# ==============================================================================
# 3. РОЗРАХУНОК СИСТЕМИ А (Класична синхронна під тим самим навантаженням)
# ==============================================================================
# 10 циліндрів стартують синхронно з 10 атм кожен -> початкова сила 100 од.
F_A_init = N * P1 * S 

# Система А розширюється, поки її сила не зрівняється з навантаженням F_load
# F_A(h) = F_A_init / (1 + h), де h - висота підйому (зміна об'єму на одиницю площі)
# Звідси гранична висота підйому до зупинки (сталінгу):
h_A_stall = (F_A_init / F_load) - 1.0

# Корисна робота системи А до моменту її повної зупинки
Work_A = F_load * h_A_stall

print("--- СИСТЕМА А (Класична синхронна під навантаженням Б) ---")
print(f"Початкова сумарна сила: {F_A_init:.2f} од. сили")
print(f"Гранична висота підйому (до зупинки процесу): {h_A_stall:.2f} м (відповідає ~4м)")
print(f"Виконана корисна робота до зупинки: {Work_A:.2f} Дж\n")

# ==============================================================================
# 4. ПОРІВНЯННЯ
# ==============================================================================
efficiency_gain = Work_B / Work_A
print("--- РЕЗУЛЬТАТ ПОРІВНЯННЯ ПРИ ОДНАКОВОМУ НАВАНТАЖЕННІ ---")
print(f"Синергетична система Б виконує більше роботи в: {efficiency_gain:.2f} рази!")
